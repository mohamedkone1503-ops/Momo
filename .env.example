# [À CONFIRMER] Mot de passe de l'espace /admin — à changer avant mise en ligne
ADMIN_PASSWORD=flex-admin-provisoire
# Clé de signature des sessions admin (chaîne aléatoire longue)
ADMIN_SECRET=remplacer-par-une-chaine-aleatoire-longue

# E-mails (confirmation client + notification salon). Sans SMTP_HOST, rien n'est envoyé.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
MAIL_FROM="Flex Hairstyle <contact@flex-hairstyle.fr>"
# [À CONFIRMER] Adresse qui reçoit les notifications de nouveaux RDV
SALON_NOTIFY_EMAIL=contact@flex-hairstyle.fr
